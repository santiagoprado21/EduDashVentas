# ID del sheet: la parte entre /d/ y /edit en la URL
# https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=

# Rango a leer (nombre de la pestaña, opcionalmente con celdas: Ventas!A1:Z)
SHEET_RANGE=Hoja 1

# Ruta al JSON de la cuenta de servicio (local)
GOOGLE_KEY_FILE=./credentials/service-account.json

# Alternativa para deploy: pegar el contenido completo del JSON en una sola línea
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Segundos que se cachea la respuesta del sheet
CACHE_TTL_SECONDS=60

PORT=3001
